# =============================================================================
# Obole — configuration
# Copier ce fichier en .env (les scripts setup-* le font automatiquement),
# puis remplir les valeurs. Le fichier .env n'est JAMAIS commité.
# =============================================================================

# --- Serveur web ---------------------------------------------------------------
# 127.0.0.1 : le serveur n'est accessible qu'en local ; le téléphone y accède
# via Tailscale (tailscale serve). Ne pas mettre 0.0.0.0.
HOST=127.0.0.1
PORT=8000

# --- Données --------------------------------------------------------------------
# Dossier de la base SQLite et des photos (relatif à la racine du dépôt ou absolu).
DATA_DIR=./data

# --- IA locale (Ollama) -----------------------------------------------------------
# Sur le PC Windows : http://localhost:11434
# Depuis le poste de dev Ubuntu (autre machine) : http://<nom-pc-windows>:11434
#   (nom Tailscale du PC ; le PC doit avoir lancé setup-windows.ps1 -RemoteOllama)
OLLAMA_URL=http://localhost:11434
# Modèle vision (voir README, « Choix du modèle »). Alternatives : qwen2.5vl:7b, qwen3.5:9b
VISION_MODEL=gemma4:e4b
# Contexte du modèle (tokens). Ne pas dépasser 4096 avec 8 Go de VRAM (débordement sur le CPU).
VISION_NUM_CTX=4096

# --- Numista ------------------------------------------------------------------------
# Clé API personnelle (voir README, « Obtenir une clé Numista »). SECRET.
NUMISTA_API_KEY=
# URL de base de l'API v3 (confirmée dans le swagger officiel, version 3.36.4)
NUMISTA_BASE_URL=https://api.numista.com/v3
# Quota du plan gratuit (requêtes par mois)
NUMISTA_MONTHLY_QUOTA=2000

# --- Sauvegarde automatique ---------------------------------------------------------
# Le serveur crée lui-même un ZIP (base + photos) à intervalle régulier, seulement si la
# collection a changé, et au démarrage s'il a raté l'échéance (PC éteint). 0 = désactivée.
BACKUP_INTERVAL_HOURS=24
# Nombre de sauvegardes automatiques conservées (les plus anciennes sont supprimées).
# Chaque ZIP contient toutes les photos : compter (taille du dossier data/photos) x BACKUP_KEEP.
BACKUP_KEEP=5
# Dossier des sauvegardes (vide = data/backups). Mieux : un autre disque ou un dossier
# synchronisé, ex. C:\Users\<moi>\OneDrive\Obole-sauvegardes
BACKUP_DIR=
